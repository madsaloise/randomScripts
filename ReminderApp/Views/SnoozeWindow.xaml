<Window x:Class="ReminderApp.Views.SnoozeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Udskyd" Height="200" Width="320"
        Icon="/app.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="10">
        <TextBlock Text="Ny forfaldstid:" Margin="0,0,0,6"/>
        <StackPanel Orientation="Horizontal">
            <DatePicker x:Name="DpDate" Width="150" Margin="0,0,6,0"/>
            <TextBox    x:Name="TxtTime" Width="80" Text="09:00"/>
        </StackPanel>
        <TextBlock Text="Eller minutter fra nu:" Margin="0,10,0,4"/>
        <TextBox x:Name="TxtMinutes" Width="80" HorizontalAlignment="Left"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnOk"     Content="OK"       Width="70" Margin="4" IsDefault="True" Click="BtnOk_Click"/>
            <Button x:Name="BtnCancel" Content="Annullér" Width="70" Margin="4" IsCancel="True" Click="BtnCancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
