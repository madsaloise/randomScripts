<Window x:Class="ReminderApp.Views.ReminderPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reminder forfalder" SizeToContent="Height" Width="420"
        Icon="/app.ico"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="True">
    <StackPanel Margin="14">
        <TextBlock x:Name="TxtDue" Foreground="Gray" Margin="0,0,0,4"/>
        <TextBlock x:Name="TxtText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="TxtNotes" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#333"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnDone"     Content="Marker udført" Margin="4" Padding="10,4" Click="BtnDone_Click"/>
            <Button x:Name="BtnSnooze15" Content="Udskyd 15 min" Margin="4" Padding="10,4" Click="BtnSnooze15_Click"/>
            <Button x:Name="BtnClose"    Content="Luk"           Margin="4" Padding="10,4" Click="BtnClose_Click" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
